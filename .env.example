# --- Wazuh Server API (user with the built-in "readonly" role) ---
WAZUH_API_URL=https://wazuh.manager:55000
WAZUH_API_USER=mcp-reader
WAZUH_API_PASSWORD=change-me

# --- Wazuh Indexer (user with read-only access to wazuh-alerts-* and wazuh-states-vulnerabilities-*) ---
WAZUH_INDEXER_URL=https://wazuh.indexer:9200
WAZUH_INDEXER_USER=mcp-reader
WAZUH_INDEXER_PASSWORD=change-me
# WAZUH_ALERTS_INDEX=wazuh-alerts-*
# WAZUH_VULN_INDEX=wazuh-states-vulnerabilities-*

# --- TLS: validate certificates (provide your CA). TLS_INSECURE=true only in a lab. ---
# TLS_CA_PATH=/certs/root-ca.pem
TLS_INSECURE=false

# --- Transport ---
# stdio (Claude Desktop / Claude Code) or http (remote, Bearer token required)
MCP_TRANSPORT=stdio
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080
# Comma-separated, >= 32 chars each. Generate with: openssl rand -hex 32
# MCP_AUTH_TOKENS=
# Browser origins allowed to call /mcp (others get 403). Leave empty for non-browser clients.
# MCP_ALLOWED_ORIGINS=

# --- Guardrails ---
MAX_RESULTS=50
MAX_TIME_WINDOW_DAYS=30
MAX_FIELD_LENGTH=2000
RATE_LIMIT_PER_MINUTE=60
REQUEST_TIMEOUT_MS=15000
AUDIT_LOG_PATH=./audit/audit.jsonl
LOG_LEVEL=info
