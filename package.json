{
  "name": "mcp-wazuh",
  "version": "1.2.0",
  "description": "Security-first, read-only MCP server for the Wazuh SIEM",
  "author": "Leonardo Nery",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Letos01/Mcp-wazuh.git"
  },
  "homepage": "https://github.com/Letos01/Mcp-wazuh#readme",
  "bugs": {
    "url": "https://github.com/Letos01/Mcp-wazuh/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "smoke": "npm run build && node scripts/smoke-stdio.mjs",
    "mock": "node scripts/mock-wazuh.mjs",
    "seed:lab": "node scripts/seed-lab-alerts.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wazuh",
    "siem",
    "security",
    "soc",
    "ai-agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "pino": "^10.4.0",
    "undici": "^8.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "bin": {
    "mcp-wazuh": "dist/index.js"
  },
  "engines": {
    "node": ">=22.12"
  }
}
